"""
Sample from a multivariate normal distribution and compare to
truth.
"""

import pandas as pd

from kanly.stats.distributions.nopython_frozen_logpdf import __frozen_internal_logpdf_multivariate_normal
import numpy as np
from kanly.api import BayesianModel

k = 3
np.random.seed(0)
mean = np.random.randn(k)
S = np.random.rand(k, k)
cov = S.T @ S
cov += 0.2 * np.eye(k)
inv_cov = np.linalg.inv(cov)
bse = np.diag(cov) ** .5


def lp(x):
    return __frozen_internal_logpdf_multivariate_normal(x, mean, inv_cov)


model = BayesianModel(lp, num_params=k)
fit = model.sample(np.zeros(k),
                   thinning=50,
                   n_samples=600_000,
                   n_burnin=40_000,
                   max_subchain_draws_sample=25_000,
                   max_subchain_draws_burnin=2_500,
                   do_mala_cd_warmup=False,
                   n_chains=10,
                   stop_adaptation_after_burnin=True,
                   user_prompt_for_more_iters=False)
print(fit)

print("Means:")
print(pd.DataFrame({
    'truth': mean,
    'sampled': fit.mean_params,
    'diff': mean / fit.mean_params - 1,
}))
print("\nStd Devs:")
print(pd.DataFrame({
    'truth': bse,
    'sampled': fit.bse,
    'diff': bse / fit.bse - 1,
}))
